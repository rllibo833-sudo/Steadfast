{
  "version": 1,
  "product_code_budget": 20000,
  "agent_path_rules": {
    "code": ["src/**", "tests/**", "skills/**", "docs/**", "evidence/**", "CHANGELOG.md", "README.md", "AGENTS.md", "agents/**", "kits/**", "pyproject.toml"],
    "media": ["assets/**", "media/**", "images/**", "videos/**", "audio/**", "public/assets/**", "public/images/**", "public/videos/**", "public/audio/**"]
  },
  "agent_protected_paths": [".steadfast/**", ".github/workflows/**", ".codex/**"],
  "allowed_paths": [
    "src/**",
    "tests/**",
    "skills/**",
    ".github/workflows/**",
    ".steadfast/**",
    "README.md",
    "LICENSE",
    ".gitignore",
    "pyproject.toml",
    "docs/**",
    "evidence/**",
    "CHANGELOG.md",
    ".codex/**",
    ".agents/**",
    "agents/**",
    "kits/**"
  ],
  "documentation_paths": [
    "README.md",
    "docs/**",
    "CHANGELOG.md",
    "ROADMAP.md",
    "ARCHITECTURE.md",
    "SPEC.md",
    "agents/**",
    "kits/**"
  ],
  "required_evidence": [
    "evidence/verification.md"
  ],
  "implementation_paths": [
    "src/**"
  ],
  "ignored_paths": [
    ".git/**",
    ".venv/**",
    "build/**",
    "dist/**",
    "__pycache__/**"
  ],
  "max_active_goals": 3,
  "forbidden_roadmap_phrases": [
    "someday",
    "maybe later",
    "future ideas"
  ]
}
