{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rllibo833-sudo/Steadfast/blob/main/ecosystem/schema.json",
  "title": "Universe Ecosystem Manifest",
  "type": "object",
  "required": [
    "manifest_version",
    "universe_id",
    "sources",
    "projects",
    "relationships"
  ],
  "properties": {
    "manifest_version": {
      "type": "string"
    },
    "universe_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "principles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "implementation_status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "implementation_status": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "purpose",
          "sources",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_id",
                "uri",
                "role"
              ],
              "properties": {
                "source_id": {
                  "type": "string"
                },
                "uri": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              }
            }
          },
          "status": {
            "type": "string"
          },
          "adapter": {
            "type": "object",
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "entrypoint": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type",
          "status"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "inventory_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
