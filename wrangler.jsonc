{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "steadfast-agent-cloud",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-27",
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"]
    }
  ],
  "workers_dev": true
}
